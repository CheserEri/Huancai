.child-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 26rpx;
}

.child-info {
  display: flex;
  align-items: center;
}

.child-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  margin-right: 16rpx;
  background: linear-gradient(150deg, #fff2f3, #fde0e3);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx rgba(200, 32, 43, 0.06);
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 14rpx;
}

.switch {
  font-size: 23rpx;
  color: var(--brand);
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  border: 1rpx solid rgba(200, 32, 43, 0.08);
}

.summary-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  border-radius: 36rpx;
  margin-bottom: 32rpx;
  background: linear-gradient(150deg, #e8544c 0%, #cc222e 48%, #a0131e 100%);
  color: #fff;
  box-shadow: 0 22rpx 44rpx -20rpx rgba(160, 19, 30, 0.6);
}

.summary-card::after {
  content: '';
  position: absolute;
  right: -120rpx;
  top: -150rpx;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 60%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 70%);
}

.summary-top {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.summary-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.summary-value {
  margin-top: 10rpx;
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -3rpx;
}

.summary-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.76);
}

.summary-side {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 148rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
}

.side-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.side-label {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.progress {
  height: 10rpx;
  border-radius: 5rpx;
  margin: 30rpx 0 14rpx;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #fff, #ffd9b8);
  transition: width 0.4s ease;
}

.summary-foot {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.course-card {
  overflow: hidden;
  padding-left: 34rpx;
}

.course-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 40rpx;
  bottom: 40rpx;
  width: 6rpx;
  border-radius: 0 3rpx 3rpx 0;
  background: linear-gradient(180deg, #ef5a52, var(--brand));
}

.course-card .progress {
  background: #f1f2f4;
  margin: 24rpx 0 16rpx;
}

.course-card .progress-inner {
  background: linear-gradient(90deg, #ee5b51, var(--brand));
}

.course-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.course-title {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.course-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
}

.course-title .muted {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.course-remain {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.remain-num {
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
  color: var(--brand);
}

.remain-label {
  margin-left: 6rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.course-meta {
  display: flex;
  justify-content: space-between;
  font-size: 23rpx;
  color: var(--text-2);
}

.course-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.course-expire {
  font-size: 21rpx;
  color: var(--text-3);
}

.album-link {
  font-size: 22rpx;
  color: var(--brand);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  border: 1rpx solid rgba(200, 32, 43, 0.08);
}

.txn-card {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}

.txn {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.txn + .txn {
  border-top: 1rpx solid var(--line);
}

.txn-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  margin-right: 22rpx;
  font-size: 34rpx;
  line-height: 66rpx;
  text-align: center;
  flex-shrink: 0;
}

.txn-icon.plus {
  background: var(--green-soft);
  color: var(--green);
}

.txn-icon.minus {
  background: var(--brand-soft);
  color: var(--brand);
}

.txn-main {
  flex: 1;
  min-width: 0;
}

.txn-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.txn-course {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.txn-num {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.txn-num.up {
  color: var(--green);
}

.txn-num.down {
  color: var(--brand);
}

.txn-sub {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
