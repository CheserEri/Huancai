<view class="page">
  <view class="msg-head">
    <text class="msg-head-title">消息通知</text>
    <text class="muted">共 {{messages.length}} 条 · {{unread}} 条未读</text>
  </view>

  <view class="card loading-card" wx:if="{{loading}}">
    <text class="muted">正在加载消息…</text>
  </view>

  <view class="card empty" wx:elif="{{error}}">
    <view class="empty-icon">!</view>
    <view>{{error}}</view>
    <button class="btn plain-btn" bindtap="retry">重新加载</button>
  </view>

  <view class="card empty" wx:elif="{{!messages.length}}">
    <view class="empty-icon">信</view>
    <view>暂无消息通知</view>
    <view class="muted empty-desc">校区推送的休课通知、上课安排会出现在这里</view>
  </view>

  <block wx:else>
    <view
      class="card msg-card {{item.readFlag ? '' : 'unread'}}"
      wx:for="{{messages}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="toggle"
    >
      <view class="msg-line">
        <text class="tag {{item.msgType === '休课通知' ? 'tag-orange' : (item.msgType === '活动海报' ? 'tag-green' : 'tag-gray')}}">{{item.msgType}}</text>
        <text class="muted">{{item.dateText}}</text>
      </view>
      <view class="msg-name-line">
        <text class="msg-name">{{item.title}}</text>
        <text class="msg-dot" wx:if="{{!item.readFlag}}"></text>
      </view>
      <text class="msg-content {{item.expanded ? 'open' : ''}}">{{item.content}}</text>
      <view class="msg-foot">
        <text class="muted">{{item.studentName || '家长'}}</text>
        <text class="msg-more">{{item.msgType === '活动海报' ? '查看海报 ›' : (item.expanded ? '收起' : '展开全文')}}</text>
      </view>
    </view>
  </block>
</view>
