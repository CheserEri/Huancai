.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 28rpx;
}

.head-left {
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: var(--text);
}

.head-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.head-badge {
  display: flex;
  align-items: baseline;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  border: 1rpx solid rgba(200, 32, 43, 0.08);
  color: var(--brand);
  font-size: 30rpx;
  font-weight: 700;
}

.badge-label {
  margin-left: 6rpx;
  font-size: 21rpx;
  font-weight: 400;
}

.timeline {
  padding-left: 4rpx;
}

.item {
  display: flex;
}

.axis {
  width: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 38rpx;
  background: #d7dbe0;
}

.dot.new {
  background: var(--brand);
  box-shadow: 0 0 0 8rpx rgba(200, 32, 43, 0.1);
}

.line {
  flex: 1;
  width: 2rpx;
  margin-top: 10rpx;
  background: linear-gradient(180deg, #e6e9ed, rgba(230, 233, 237, 0.2));
}

.item-card {
  flex: 1;
  margin-left: 20rpx;
  padding: 28rpx 30rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-tags {
  display: flex;
  align-items: center;
}

.new-flag {
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  font-size: 19rpx;
  color: var(--brand);
}

.content {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.78;
  color: var(--text);
}

.meta {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.more {
  padding: 28rpx 0 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
}

.more.muted {
  color: var(--text-3);
}
