.child-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 26rpx;
}

.child-info {
  display: flex;
  align-items: center;
}

.child-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  margin-right: 16rpx;
  background: linear-gradient(150deg, #fff2f3, #fde0e3);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 52rpx;
  text-align: center;
  font-weight: 600;
  box-shadow: inset 0 0 0 1rpx rgba(200, 32, 43, 0.06);
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 14rpx;
}

.switch {
  font-size: 23rpx;
  color: var(--brand);
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  border: 1rpx solid rgba(200, 32, 43, 0.08);
}

.album-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rpx 8rpx 18rpx;
  font-size: 25rpx;
  color: var(--text-2);
}

.album-card {
  padding: 26rpx 24rpx 20rpx;
}

.album-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.album-title {
  display: flex;
  flex-direction: column;
  max-width: 460rpx;
}

.album-name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
}

.album-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.album-count {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -5rpx;
}

.photo-item {
  width: 33.333%;
  padding: 5rpx;
  box-sizing: border-box;
}

.photo {
  display: block;
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
}
