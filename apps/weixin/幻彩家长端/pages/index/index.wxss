.home {
  min-height: 100vh;
  background: var(--bg);
}

/* 顶部品牌区：渐变 + 柔光装饰，底部大圆角包裹内容 */
.hero {
  position: relative;
  overflow: hidden;
  padding: 16rpx 32rpx 118rpx;
  background: linear-gradient(150deg, #e8544c 0%, #cc222e 44%, #a0131e 100%);
  border-radius: 0 0 56rpx 56rpx;
}

.orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.orb-a {
  width: 420rpx;
  height: 420rpx;
  right: -150rpx;
  top: -190rpx;
  background: radial-gradient(circle at 35% 65%, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0) 68%);
}

.orb-b {
  width: 300rpx;
  height: 300rpx;
  left: -110rpx;
  bottom: -100rpx;
  background: radial-gradient(circle at 60% 35%, rgba(255, 210, 170, 0.22), rgba(255, 255, 255, 0) 70%);
}

.hero-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
}

/* 品牌标识：玻璃质感徽标 + 文字，无白底 */
.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0.08) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55), 0 10rpx 20rpx -10rpx rgba(90, 10, 16, 0.55);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 58rpx;
  text-align: center;
}

.brand-lockup {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 3rpx;
  color: #fff;
}

.brand-tag {
  margin-top: 2rpx;
  font-size: 17rpx;
  line-height: 1.4;
  letter-spacing: 6rpx;
  color: rgba(255, 255, 255, 0.55);
}

.greet {
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
  color: rgba(255, 255, 255, 0.84);
}

.child-tabs {
  position: relative;
  white-space: nowrap;
  margin-top: 20rpx;
}

.child-tab {
  display: inline-flex;
  align-items: center;
  height: 58rpx;
  padding: 0 26rpx 0 10rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.92);
  font-size: 25rpx;
}

.child-tab.on {
  background: #fff;
  border-color: #fff;
  color: var(--brand);
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(90, 10, 16, 0.18);
}

.child-dot {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: rgba(255, 255, 255, 0.24);
  color: inherit;
  font-size: 21rpx;
  line-height: 38rpx;
  text-align: center;
}

.child-tab.on .child-dot {
  background: #fdeef0;
}

.hero-card {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 34rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-value {
  margin-top: 8rpx;
  font-size: 96rpx;
  line-height: 1.05;
  font-weight: 700;
  letter-spacing: -3rpx;
  color: #fff;
}

.hero-unit {
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.76);
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-progress {
  width: 100%;
  max-width: 380rpx;
  height: 8rpx;
  margin-top: 24rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
}

.hero-progress-inner {
  height: 100%;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #fff, #ffd9b8);
  transition: width 0.4s ease;
}

.hero-progress-text {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.62);
}

.hero-badge {
  flex-shrink: 0;
  width: 152rpx;
  height: 152rpx;
  margin-left: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  box-shadow: inset 0 0 40rpx rgba(255, 255, 255, 0.14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.hero-badge-num {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero-badge-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.8);
}

.body {
  position: relative;
  margin-top: -92rpx;
  padding: 0 28rpx 48rpx;
}

/* 快捷数据：浮在白底之上，用颜色区分数字 */
.quick {
  display: flex;
  align-items: center;
  padding: 34rpx 8rpx;
  margin-bottom: 8rpx;
  border-radius: 32rpx;
  box-shadow: 0 18rpx 44rpx -18rpx rgba(26, 28, 32, 0.2);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.quick-item + .quick-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: linear-gradient(180deg, rgba(239, 240, 242, 0), #e9eaec, rgba(239, 240, 242, 0));
}

.quick-num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--text);
}

.quick-item:nth-child(1) .quick-num {
  color: var(--brand);
}

.quick-item:nth-child(2) .quick-num {
  color: var(--amber);
}

.quick-item:nth-child(3) .quick-num {
  color: var(--green);
}

.quick-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.comment-card {
  padding-right: 44rpx;
  overflow: hidden;
}

.comment-card::after {
  content: '“';
  position: absolute;
  right: 22rpx;
  top: 0;
  font-size: 110rpx;
  line-height: 1;
  font-family: Georgia, serif;
  color: rgba(200, 32, 43, 0.07);
}

.comment-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-text {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
}

.comment-meta {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: var(--text-3);
}

.grade-card {
  display: flex;
  align-items: center;
}

.grade-score {
  display: flex;
  align-items: baseline;
  min-width: 136rpx;
  color: var(--brand);
}

.grade-score text:first-child {
  font-size: 66rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
}

.score-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.grade-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-left: 22rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid var(--line);
}

.grade-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.grade-info .muted {
  margin-top: 8rpx;
}

.list-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.lesson {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.lesson + .lesson {
  border-top: 1rpx solid var(--line);
}

.lesson-date {
  width: 210rpx;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.ld-day {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.ld-time {
  margin-top: 5rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.lesson-line {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand);
  box-shadow: 0 0 0 7rpx rgba(200, 32, 43, 0.09);
  margin-right: 24rpx;
  flex-shrink: 0;
}

.lesson-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.lesson-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lesson-main .muted {
  margin-top: 6rpx;
}

.act-scroll {
  white-space: nowrap;
  margin: 0 -28rpx;
  padding: 2rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.act-card {
  display: inline-flex;
  flex-direction: column;
  width: 486rpx;
  margin-right: 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(158deg, #fff8f6 0%, #ffffff 52%);
  border: 1rpx solid #fbe4e4;
  box-shadow: 0 12rpx 28rpx -14rpx rgba(200, 32, 43, 0.18);
  box-sizing: border-box;
  white-space: normal;
  vertical-align: top;
}

.act-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.act-type {
  font-size: 20rpx;
  color: var(--text-3);
}

.act-name {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text);
}

.act-rule {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--brand);
}

.act-date {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

/* 消息通知入口 */
.notice-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-top: -4rpx;
}

.notice-left {
  display: flex;
  align-items: center;
}

.notice-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.notice-text {
  display: flex;
  flex-direction: column;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.notice-right {
  display: flex;
  align-items: center;
}

.notice-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  margin-right: 12rpx;
  border-radius: 17rpx;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

.notice-arrow {
  color: var(--text-3);
  font-size: 34rpx;
  line-height: 1;
}
