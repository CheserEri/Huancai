<view class="profile">
  <view class="header">
    <view class="header-orb"></view>
    <view class="user">
      <view class="avatar">{{parent.initial || '家'}}</view>
      <view class="user-info">
        <text class="nickname">{{parent.nickname || '微信家长'}}</text>
        <text class="phone">{{parent.phone || '欢迎使用幻彩学堂家长端'}}</text>
      </view>
    </view>
  </view>

  <view class="body">
    <view class="card loading-card" wx:if="{{loading}}">
      <text class="muted">正在加载…</text>
    </view>

    <view class="card empty" wx:elif="{{error}}">
      <view class="empty-icon">!</view>
      <view>{{error}}</view>
      <button class="btn plain-btn" bindtap="load">重新加载</button>
    </view>

    <block wx:else>
      <view class="section">
        <text class="section-title">我的孩子</text>
        <text class="section-more" bindtap="goBind">+ 绑定孩子</text>
      </view>

      <view class="card child-card" wx:for="{{children}}" wx:key="studentId">
        <view class="child-row" data-id="{{item.studentId}}" bindtap="viewChild">
          <view class="child-avatar">{{item.initial}}</view>
          <view class="child-main">
            <view class="child-name-line">
              <text class="child-name">{{item.name}}</text>
              <text class="tag tag-gray" wx:if="{{item.grade}}">{{item.grade}}</text>
            </view>
            <text class="muted">{{item.campusName || '幻彩学堂'}}{{item.relation ? ' · ' + item.relation : ''}}</text>
          </view>
          <view class="child-remain">
            <text class="remain-num">{{item.remainText}}</text>
            <text class="remain-label">剩余课时</text>
          </view>
        </view>
        <view class="child-actions">
          <text class="action" data-id="{{item.studentId}}" bindtap="goComments">课堂表现</text>
          <text class="action danger" data-id="{{item.studentId}}" bindtap="unbind">解除绑定</text>
        </view>
      </view>

      <view class="card empty" wx:if="{{!children.length}}">
        <view class="empty-icon">+</view>
        <view>还没有绑定孩子</view>
        <view class="muted empty-desc">绑定后即可查看课时、成绩和课堂表现</view>
        <button class="btn plain-btn" bindtap="goBind">立即绑定</button>
      </view>

      <view class="section">
        <text class="section-title">学习服务</text>
      </view>
      <view class="card menu">
        <view class="menu-item" bindtap="goMessages">
          <text class="menu-icon">信</text>
          <text class="menu-text">消息通知</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" data-url="/pages/lessons/lessons" bindtap="goTab">
          <text class="menu-icon">课</text>
          <text class="menu-text">课时账户</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" data-url="/pages/grades/grades" bindtap="goTab">
          <text class="menu-icon">分</text>
          <text class="menu-text">成绩变化</text>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" data-url="/pages/activities/activities" bindtap="goTab">
          <text class="menu-icon">惠</text>
          <text class="menu-text">活动福利</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="section">
        <text class="section-title">关于</text>
      </view>
      <view class="card about">
        <view class="about-line">
          <text>幻彩学堂家长端</text>
          <text class="muted">v{{version}}</text>
        </view>
        <view class="about-desc">数据与幻彩校区员工系统实时同步，课时、成绩和课堂表现以校区档案为准。</view>
      </view>
    </block>
  </view>
</view>
