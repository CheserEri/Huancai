.profile {
  min-height: 100vh;
  background: var(--bg);
}

.header {
  position: relative;
  overflow: hidden;
  padding: 24rpx 32rpx 120rpx;
  background: linear-gradient(150deg, #e8544c 0%, #cc222e 44%, #a0131e 100%);
  border-radius: 0 0 56rpx 56rpx;
}

.header-orb {
  position: absolute;
  right: -140rpx;
  top: -180rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 40% 60%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 70%);
}

.user {
  position: relative;
  display: flex;
  align-items: center;
  padding-top: 20rpx;
}

.avatar {
  width: 118rpx;
  height: 118rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  box-shadow: inset 0 0 30rpx rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 114rpx;
  text-align: center;
}

.user-info {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.nickname {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: #fff;
}

.phone {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.76);
}

.body {
  position: relative;
  margin-top: -88rpx;
  padding: 0 28rpx 52rpx;
}

.child-card {
  padding: 28rpx;
}

.child-row {
  display: flex;
  align-items: center;
}

.child-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 30rpx;
  background: linear-gradient(150deg, #fff2f3, #fde0e3);
  color: var(--brand);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1rpx rgba(200, 32, 43, 0.06);
}

.child-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
  min-width: 0;
}

.child-name-line {
  display: flex;
  align-items: center;
}

.child-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-right: 12rpx;
}

.child-main .muted {
  margin-top: 8rpx;
}

.child-remain {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.remain-num {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: var(--brand);
}

.remain-label {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--text-3);
}

.child-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.action {
  margin-left: 20rpx;
  padding: 9rpx 24rpx;
  border-radius: 999rpx;
  background: #f6f6f7;
  color: var(--text-2);
  font-size: 23rpx;
}

.action.danger {
  color: var(--brand);
  background: var(--brand-soft);
}

.menu {
  padding: 8rpx 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.menu-item + .menu-item {
  border-top: 1rpx solid var(--line);
}

.menu-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 62rpx;
  text-align: center;
  margin-right: 22rpx;
  font-weight: 500;
}

.menu-item:nth-child(2) .menu-icon {
  background: var(--amber-soft);
  color: #c97a12;
}

.menu-item:nth-child(3) .menu-icon {
  background: var(--green-soft);
  color: var(--green);
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.menu-arrow {
  font-size: 32rpx;
  color: #c8ccd1;
}

.about {
  padding: 28rpx 30rpx;
}

.about-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.about-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text-3);
}
