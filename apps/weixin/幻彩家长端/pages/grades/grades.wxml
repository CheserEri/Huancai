<view class="page">
  <view class="child-bar" wx:if="{{child}}">
    <view class="child-info">
      <text class="child-dot">{{child.initial}}</text>
      <text class="child-name">{{child.name}}</text>
      <text class="muted" wx:if="{{child.grade}}">{{child.grade}}</text>
    </view>
    <text class="switch" wx:if="{{stats}}" bindtap="switchChild">切换孩子</text>
  </view>

  <view class="card loading-card" wx:if="{{loading}}">
    <text class="muted">正在加载成绩…</text>
  </view>

  <view class="card empty" wx:elif="{{error}}">
    <view class="empty-icon">!</view>
    <view>{{error}}</view>
    <button class="btn plain-btn" bindtap="load">重新加载</button>
  </view>

  <view class="card empty" wx:elif="{{noChild}}">
    <view class="empty-icon">+</view>
    <view>还没有绑定孩子</view>
    <button class="btn plain-btn" bindtap="goBind">绑定孩子</button>
  </view>

  <view class="card empty" wx:elif="{{!records.length}}">
    <view class="empty-icon">—</view>
    <view>暂时还没有已发布的成绩</view>
    <view class="muted empty-desc">老师发布成绩后，这里会显示每次考试的分数变化</view>
  </view>

  <block wx:else>
    <view class="stats-card">
      <view class="stats-top">
        <view class="stats-latest">
          <text class="stats-label">最近一次</text>
          <view class="stats-score">{{stats.latestText}}<text class="stats-unit">分</text></view>
          <text class="stats-delta {{stats.latestDeltaClass}}">{{stats.latestDelta ? '较上次 ' + stats.latestDelta : '首次记录'}}</text>
        </view>
        <view class="stats-right">
          <view class="stats-item">
            <text class="item-num">{{stats.bestText}}</text>
            <text class="item-label">最高分</text>
          </view>
          <view class="stats-item">
            <text class="item-num">{{stats.count}}</text>
            <text class="item-label">考试次数</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card trend-card" wx:if="{{trend.length}}">
      <view class="section">
        <text class="section-title">成绩趋势</text>
        <text class="section-more">最近 {{trend.length}} 次</text>
      </view>
      <scroll-view class="chart" scroll-x>
        <view class="chart-inner">
          <view class="bar-col" wx:for="{{trend}}" wx:key="key">
            <text class="bar-score">{{item.scoreText}}</text>
            <view class="bar-track">
              <view class="bar {{item.barClass}}" style="height: {{item.barHeight}}rpx"></view>
            </view>
            <text class="bar-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="section">
      <text class="section-title">考试记录</text>
      <text class="section-more">仅显示已发布成绩</text>
    </view>

    <view class="card exam-card" wx:for="{{records}}" wx:key="examId">
      <view class="exam-head">
        <view class="exam-title">
          <view class="exam-name-line">
            <text class="exam-name">{{item.examName}}</text>
            <text class="tag tag-gray">{{item.examType}}</text>
          </view>
          <text class="muted">{{item.dateText}}{{item.className ? ' · ' + item.className : ''}}</text>
        </view>
        <view class="exam-score">
          <text class="score-num">{{item.scoreText}}</text>
          <text class="score-full">/ {{item.fullText}}</text>
        </view>
      </view>
      <view class="exam-foot">
        <view class="exam-tags">
          <text class="tag" wx:if="{{item.rankText}}">{{item.rankText}}</text>
          <text class="tag tag-green" wx:if="{{item.level}}">{{item.level}}</text>
          <text class="tag tag-orange" wx:if="{{item.status !== '正常'}}">{{item.status}}</text>
        </view>
        <text class="delta {{item.deltaClass}}" wx:if="{{item.deltaText}}">{{item.deltaText}}</text>
      </view>
      <view class="exam-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
      <view class="exam-paper" wx:if="{{item.paperImage}}" data-src="{{item.paperImage}}" bindtap="previewPaper">
        <text>查看试卷图片</text>
      </view>
    </view>
  </block>
</view>
