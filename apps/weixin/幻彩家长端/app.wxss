page {
  --brand: #c8202b;
  --brand-deep: #96121c;
  --brand-soft: #fdeef0;
  --amber: #ef9c33;
  --amber-soft: #fff4e3;
  --green: #12a05c;
  --green-soft: #e8f7ef;
  --text: #1a1c20;
  --text-2: #62686f;
  --text-3: #9aa1a8;
  --line: #eff0f2;
  --bg: #f5f4f2;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片：细腻描边 + 柔和分层阴影，避免纯白块贴底 */
.card {
  position: relative;
  background: #fff;
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(26, 28, 32, 0.035);
  box-shadow: 0 12rpx 32rpx -12rpx rgba(26, 28, 32, 0.12);
  box-sizing: border-box;
}

.section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 6rpx 18rpx;
}

.section-title {
  position: relative;
  padding-left: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--text);
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 26rpx;
  margin-top: -13rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #ef5a52, var(--brand));
}

.section-more {
  font-size: 23rpx;
  color: var(--text-3);
}

.muted {
  color: var(--text-3);
  font-size: 24rpx;
}

.secondary {
  color: var(--text-2);
}

.brand {
  color: var(--brand);
}

.empty {
  padding: 72rpx 30rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.empty-icon {
  width: 116rpx;
  height: 116rpx;
  margin: 0 auto 22rpx;
  border-radius: 40rpx;
  background: linear-gradient(150deg, #fff2f3, #fde3e6);
  color: var(--brand);
  font-size: 52rpx;
  line-height: 116rpx;
  font-weight: 300;
  box-shadow: inset 0 0 0 1rpx rgba(200, 32, 43, 0.06);
}

.empty-desc {
  margin: 14rpx auto 28rpx;
  max-width: 460rpx;
  line-height: 1.65;
}

/* 按钮统一用 flex 居中，避免默认行高/内边距导致文字偏上或偏下 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  line-height: 1;
  padding: 0 24rpx;
  margin-left: auto;
  margin-right: auto;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #ea4a4a 0%, #c8202b 55%, #a51520 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-align: center;
  border: none;
  box-sizing: border-box;
  box-shadow: 0 16rpx 30rpx -12rpx rgba(200, 32, 43, 0.55);
}

.btn::after {
  border: none;
}

.btn-plain {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid #f4cdd1;
  box-shadow: 0 8rpx 20rpx -10rpx rgba(200, 32, 43, 0.25);
}

.btn-sm {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.tag {
  display: inline-block;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
  background: var(--brand-soft);
  color: var(--brand);
}

.tag-gray {
  background: #f2f3f5;
  color: var(--text-2);
}

.tag-green {
  background: var(--green-soft);
  color: var(--green);
}

.tag-orange {
  background: var(--amber-soft);
  color: #c97a12;
}

.delta {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.delta.up {
  background: var(--green-soft);
  color: var(--green);
}

.delta.down {
  background: var(--brand-soft);
  color: var(--brand);
}

.delta.flat {
  background: #f2f3f5;
  color: var(--text-3);
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-card {
  text-align: center;
  padding: 56rpx 30rpx;
}

.small {
  padding: 36rpx 24rpx;
}

.plain-btn {
  width: 320rpx !important;
  margin-top: 26rpx;
}
